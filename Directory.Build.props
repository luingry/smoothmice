<Project>
  <PropertyGroup>
    <!-- App + installer semver version; the single source of truth (bumped manually with commits). -->
    <Version>2.2.13</Version>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- System.Memory: Span<T>/Memory<T> para net48 -->
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.5.*" />
  </ItemGroup>
  <!-- Polyfills para C# 9+ features no .NET Framework 4.8 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Include="$(MSBuildThisFileDirectory)src\Polyfills.cs" />
  </ItemGroup>
</Project>
