<UserControl x:Class="SmoothMice.Module.ModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk">
    <!-- Design-system keys only (SwissTechKnife.Sdk theme, resolved from the host at runtime). -->
    <ScrollViewer Padding="28,8,28,28">
        <Border Style="{StaticResource Card}" Padding="24" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rolagem suave" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                    <Border x:Name="StatusChip" Grid.Column="1" Style="{StaticResource Chip}">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusDetail" Style="{StaticResource Text.Paragraph}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                           Text="Perfis, animação e aceleração ficam na janela do SmoothMice, que roda em um processo próprio para que o SwissTechKnife nunca atrase a rolagem." />
                <Button x:Name="OpenButton" Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE8A7;"
                        Content="Abrir SmoothMice" HorizontalAlignment="Left" Margin="0,20,0,0" Click="OpenButton_OnClick" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
