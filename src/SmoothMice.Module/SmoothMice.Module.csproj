<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SwissTechKnife module: a thin supervisor that runs SmoothMice.App in its own process (hosted mode).
    The app is packaged next to it by scripts/pack-module.ps1; this assembly only depends on the SDK.
  -->
  <PropertyGroup>
    <RootNamespace>SmoothMice.Module</RootNamespace>
    <AssemblyName>SmoothMice.Module</AssemblyName>
    <!-- Module package version (module.json); independent of the standalone app version. -->
    <Version>3.0.0</Version>
    <UseWPF>true</UseWPF>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Nothing but the SDK may ship with the module dll. -->
    <PackageReference Remove="System.Memory" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile-only: the host provides the one shared copy at runtime. Refresh from a SwissTechKnife build. -->
    <Reference Include="SwissTechKnife.Sdk" HintPath="lib\SwissTechKnife.Sdk.dll" Private="false" />
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
