<Window x:Class="SmoothMice.App.ProfileAddSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add profile"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Add app profile" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Margin="0,5,0,14" Text="Choose how to find the executable for this profile." FontSize="12" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Padding="12,9" Margin="0,0,8,0" Click="SelectExecutable_OnClick"
                    IsDefault="True" AutomationProperties.Name="Select executable by path"
                    AutomationProperties.HelpText="Opens the file picker to choose an executable program.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Select executable" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Padding="12,9" Click="SelectRunningWindow_OnClick"
                    AutomationProperties.Name="Select running window"
                    AutomationProperties.HelpText="Lists visible running windows so you can choose the application.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Select running window" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Button Grid.Row="2" Content="Cancel" HorizontalAlignment="Right" MinWidth="82" Margin="0,16,0,0"
                IsCancel="True" AutomationProperties.Name="Cancel adding profile" />
    </Grid>
</Window>
