<Window x:Class="SmoothMice.App.ScrollPulseMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmoothMice.App.ViewModels"
        Title="Scroll logs · SmoothMice"
        Width="680"
        Height="520"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Monitor_OnLoaded"
        Closed="Monitor_OnClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MonitorLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding Markers}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                    <Setter Property="Background" Value="#FFF7ED"/>
                    <Setter Property="Foreground" Value="#9A3412"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <Button Content="Clear"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Padding="10,5"
                    Click="Clear_OnClick"
                    ToolTip="Clears the pulses in this view to start a controlled test"
                    AutomationProperties.Name="Clear scroll logs"/>
            <StackPanel>
                <TextBlock Text="Scroll logs" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Physical pulses before smoothing" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource Brush.Muted}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Margin="0,10,0,8"
                   FontSize="11"
                   Foreground="{StaticResource Brush.Muted}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>

        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="captured" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding AxisText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="by axis" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding BurstText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="burst pulses (120 ms)" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="{Binding ReversalText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="within 150 ms" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="PulseList"
                      ItemsSource="{Binding Rows}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1"
                      Background="{StaticResource Brush.Card}"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Physical scroll pulses">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="TIME" Width="82" DisplayMemberBinding="{Binding RelativeTime}"/>
                        <GridViewColumn Header="UTC" Width="102" DisplayMemberBinding="{Binding UtcTime}"/>
                        <GridViewColumn Header="AXIS" Width="78" DisplayMemberBinding="{Binding Axis}"/>
                        <GridViewColumn Header="PULSE" Width="72" DisplayMemberBinding="{Binding DeltaAndDirection}"/>
                        <GridViewColumn Header="INTERVAL" Width="75" DisplayMemberBinding="{Binding Interval}"/>
                        <GridViewColumn Header="WINDOW" Width="82" DisplayMemberBinding="{Binding BurstWindow}"/>
                        <GridViewColumn Header="MARKERS" Width="125" DisplayMemberBinding="{Binding Markers}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock Text="Turn the wheel to start"
                       Visibility="{Binding EmptyStateVisible, Converter={StaticResource BoolToVis}}"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{StaticResource Brush.Muted}"/>
        </Grid>
    </Grid>
</Window>
