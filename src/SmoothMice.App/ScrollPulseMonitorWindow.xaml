<Window x:Class="SmoothMice.App.ScrollPulseMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmoothMice.App.ViewModels"
        Title="Scroll logs · SmoothMice"
        Width="748"
        Height="520"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Monitor_OnLoaded"
        Closed="Monitor_OnClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MonitorLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Every GridViewColumn cell is wrapped in this template so columns get a visible
             divider between them; DisplayMemberBinding alone only separates data by header,
             with no visual delimiter between adjacent cell values. -->
        <Style x:Key="MonitorCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
        <Style x:Key="MonitorCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The global App.xaml ListViewItem template swaps in a plain ContentPresenter, which
             renders a bound item via ToString() — fine for plain lists, but it means a GridView's
             columns/CellTemplates are never consulted. A GridView row needs a
             GridViewRowPresenter in its template to lay cells out per GridViewColumn, so this
             window overrides the template locally rather than changing the shared style (which
             would break every other, non-GridView ListView in the app). -->
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding Markers}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemRoot" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                   Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Brush.SelectedSurface}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="ItemRoot" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSurface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <Button Content="Clear"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Padding="10,5"
                    Click="Clear_OnClick"
                    ToolTip="Clears the pulses in this view to start a controlled test"
                    AutomationProperties.Name="Clear scroll logs"/>
            <StackPanel>
                <TextBlock Text="Scroll logs" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="Physical pulses before smoothing" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,8">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding TickDiagnosticsText}"
                       Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="captured" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding AxisText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="by axis" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding BurstText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="burst pulses (120 ms)" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="{Binding ReversalText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="within 150 ms" Style="{StaticResource MonitorLabel}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="PulseList"
                      ItemsSource="{Binding Rows}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1"
                      Background="{DynamicResource Brush.Card}"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Physical scroll pulses">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="TIME" Width="82">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding RelativeTime}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="UTC" Width="102">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding UtcTime}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="AXIS" Width="72">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding Axis}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="PULSE" Width="68">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding DeltaAndDirection}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="PIXELS" Width="68">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding PixelDelta}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="INTERVAL" Width="75">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding Interval}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="WINDOW" Width="82">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding BurstWindow}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="MARKERS" Width="115">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonitorCell}" BorderThickness="0">
                                        <TextBlock Style="{StaticResource MonitorCellText}" Text="{Binding Markers}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock Text="Turn the wheel to start"
                       Visibility="{Binding EmptyStateVisible, Converter={StaticResource BoolToVis}}"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Muted}"/>
        </Grid>
    </Grid>
</Window>
