<Window x:Class="SmoothMice.App.FreeSpinInertiaSuppressionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free-Spin Inertia Suppression · SmoothMice"
        Width="560"
        SizeToContent="Height"
        MinWidth="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closed="Window_OnClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ModuleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.ToggleOff}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="16">
                            <Grid Margin="3">
                                <Ellipse x:Name="Thumb" Width="26" Height="26" Fill="White" HorizontalAlignment="Left" />
                                <TextBlock x:Name="StateText" Text="OFF" Margin="0,0,5,0" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="StateText" Property="Text" Value="ON" />
                                <Setter TargetName="StateText" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="StateText" Property="Margin" Value="5,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Free-Spin Inertia Suppression" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                               Text="Drops the unwanted scroll caused by a free-spin wheel rocking when the mouse is lifted or put down. Every pulse is decided instantly: nothing is ever delayed." />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                               Text="Only useful on mice with a free-spin wheel. Leave it off otherwise." />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <ToggleButton Style="{StaticResource ModuleSwitch}" IsChecked="{Binding ModuleEnabled, Mode=TwoWay}" Checked="ModuleSwitch_OnChanged" Unchecked="ModuleSwitch_OnChanged"
                                  AutomationProperties.Name="Enable Free-Spin Inertia Suppression"
                                  AutomationProperties.HelpText="When off, wheel input is never inspected." />
                    <TextBlock Text="Module" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding ModuleEnabled, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Mode" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <RadioButton GroupName="detectionMode" Content="Read-only" IsChecked="{Binding IsReadOnlyMode, Mode=TwoWay}"
                                     AutomationProperties.Name="Read-only mode" AutomationProperties.HelpText="Classifies wheel pulses but never blocks them." />
                        <RadioButton GroupName="detectionMode" Content="Suppress" IsChecked="{Binding IsSuppressMode, Mode=TwoWay}"
                                     AutomationProperties.Name="Suppress mode" AutomationProperties.HelpText="Drops wheel pulses identified as inertia." />
                    </UniformGrid>
                    <TextBlock Text="{Binding DetectorSummary, Mode=OneWay}" Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Live decisions" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding LatestVerdict, Mode=OneWay}" Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding DetectorCountersText, Mode=OneWay}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Record decision log" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding DecisionLogText, Mode=OneWay}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ModuleSwitch}" IsChecked="{Binding LogDecisions, Mode=TwoWay}"
                                  AutomationProperties.Name="Record decision log"
                                  AutomationProperties.HelpText="Writes every Free-Spin decision to a diagnostics file. Off by default." />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
