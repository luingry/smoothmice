<Window x:Class="SmoothMice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SmoothMice.App.Converters"
        Title="SmoothMice"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_OnLoaded"
        ContentRendered="MainWindow_OnContentRendered"
        Closing="MainWindow_OnClosing">

    <Window.Resources>
        <c:DoubleStringConverter x:Key="DoubleStr" />
        <c:IntStringConverter    x:Key="IntStr" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="Margin"     Value="0,10,0,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin"     Value="0,5,0,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height"      Value="26"/>
            <Setter Property="Padding"     Value="5,3"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height"   Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <!-- Background + layout rounding on root avoids empty strip (WPF SizeToContent + fixed resize chrome). -->
    <Grid Margin="16,12,16,10"
          Background="#F0F0F0"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title + version ──────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Text="SmoothMice" FontSize="20" FontWeight="SemiBold"
                           Foreground="#111" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"/>
                <Button Content="?" Width="24" Height="24"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Help_OnClick"/>
            </Grid>
            <TextBlock x:Name="VersionLabel"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"
                       FontSize="9"
                       Foreground="#BBBBBB"
                       SnapsToDevicePixels="True"/>
        </Grid>

        <!-- ── Global toggles ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox Content="Auto start on login"
                      IsChecked="{Binding AutoStartOnLogin, Mode=TwoWay}"
                      Checked="PersistCheck_OnChanged"
                      Unchecked="PersistCheck_OnChanged"
                      Margin="0,0,20,0"/>
            <CheckBox Content="Enabled"
                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                      Checked="PersistCheck_OnChanged"
                      Unchecked="PersistCheck_OnChanged"/>
        </StackPanel>

        <!-- ── Updates ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource SectionHeader}" Margin="0,0,0,3"/>
            <DockPanel LastChildFill="True">
                <Button Content="Verificar atualizações" DockPanel.Dock="Right"
                        Padding="10,4" Margin="10,0,0,0"
                        Command="{Binding CheckForUpdatesCommand}"/>
                <ComboBox x:Name="UpdateFreqCombo"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Frequency"
                          ItemsSource="{Binding UpdateFrequencyOptions}"
                          SelectedValue="{Binding UpdateCheckFrequency, Mode=TwoWay}"
                          SelectionChanged="UpdateFreqCombo_OnSelectionChanged"/>
            </DockPanel>
        </StackPanel>

        <!-- ── Profile selector ─────────────────────────────────────────── -->
        <ComboBox Grid.Row="3" x:Name="ProfileCombo"
                  Margin="0,0,0,10"
                  SelectionChanged="ProfileCombo_OnSelectionChanged"/>

        <!-- ── Settings card ────────────────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                BorderBrush="#D8D8D8"
                BorderThickness="1">
            <Grid Margin="16,12"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ LEFT — Animation + Behaviour ══════════════════ -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="ANIMATION" Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="Step size (px)" Style="{StaticResource FieldLabel}"/>
                        <TextBox LostFocus="Numeric_OnLostFocus"
                                 Text="{Binding StepSizePx, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus,
                                                Converter={StaticResource DoubleStr}}"/>

                        <TextBlock Text="Animation time (ms)" Style="{StaticResource FieldLabel}"/>
                        <TextBox LostFocus="Numeric_OnLostFocus"
                                 Text="{Binding AnimationTimeMs, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus,
                                                Converter={StaticResource IntStr}}"/>

                        <TextBlock Text="Tail / head ratio" Style="{StaticResource FieldLabel}"/>
                        <TextBox LostFocus="Numeric_OnLostFocus"
                                 Text="{Binding TailToHeadRatio, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus,
                                                Converter={StaticResource DoubleStr}}"/>

                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionHeader}"/>

                        <CheckBox Content="Animation easing"
                                  IsChecked="{Binding AnimationEasing, Mode=TwoWay}"
                                  Checked="PersistCheck_OnChanged"
                                  Unchecked="PersistCheck_OnChanged"
                                  Margin="0,4,0,0"/>

                        <CheckBox Content="Horizontal scrolling"
                                  IsChecked="{Binding HorizontalSmoothness, Mode=TwoWay}"
                                  Checked="PersistCheck_OnChanged"
                                  Unchecked="PersistCheck_OnChanged"
                                  Margin="0,8,0,0"/>

                        <CheckBox Content="Enable for all apps"
                                  IsChecked="{Binding EnableForAllAppsByDefault, Mode=TwoWay}"
                                  Checked="PersistCheck_OnChanged"
                                  Unchecked="PersistCheck_OnChanged"
                                  Margin="0,8,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="FontSize"   Value="12"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGlobalProfile}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Grid.Column="1" Fill="#E8E8E8" Width="1"
                               VerticalAlignment="Stretch" Margin="0,4"/>

                    <!-- ═══ RIGHT — Acceleration ═══════════════════════════ -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="ACCELERATION" Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="Curve preset" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="AccelPresetCombo"
                                  ItemsSource="{Binding AccelPresetNames,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectionChanged="AccelPreset_OnSelectionChanged"/>

                        <TextBlock Text="Exponent" Style="{StaticResource FieldLabel}"
                                   ToolTip="0 = disabled · 1 = linear · 1.3 = smooth · 2 = exponential"/>
                        <TextBox LostFocus="Numeric_OnLostFocus"
                                 Text="{Binding AccelerationExponent, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus,
                                                Converter={StaticResource DoubleStr}}"/>

                        <TextBlock Text="Max multiplier" Style="{StaticResource FieldLabel}"/>
                        <TextBox LostFocus="Numeric_OnLostFocus"
                                 Text="{Binding AccelerationMaxX, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus,
                                                Converter={StaticResource DoubleStr}}"/>

                        <TextBlock Text="Reference interval (ms)" Style="{StaticResource FieldLabel}"
                                   ToolTip="Scroll speed at this interval = 1× multiplier"/>
                        <TextBox LostFocus="Numeric_OnLostFocus"
                                 Text="{Binding AccelerationDeltaMs, Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus,
                                                Converter={StaticResource IntStr}}"/>

                    </StackPanel>
            </Grid>
        </Border>

        <!-- ── Action bar ────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,10,0,0">
            <Button Content="Reset All" DockPanel.Dock="Left"
                    Padding="10,4" Command="{Binding ResetAllCommand}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="+" Width="30" Height="26" Margin="0,0,6,0"
                        Command="{Binding AddProfileCommand}"/>
                <Button Content="—" Width="30" Height="26"
                        Command="{Binding RemoveProfileCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
