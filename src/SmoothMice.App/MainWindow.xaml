<Window x:Class="SmoothMice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SmoothMice.App.Converters"
        xmlns:vm="clr-namespace:SmoothMice.App.ViewModels"
        Title="SmoothMice"
        MinWidth="320"
        MinHeight="680"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_OnLoaded"
        ContentRendered="MainWindow_OnContentRendered"
        Closing="MainWindow_OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <c:DoubleStringConverter x:Key="DoubleStr" />
        <c:IntStringConverter    x:Key="IntStr" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,6,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10,12,10,10"
          Width="288"
          MinWidth="288"
          MaxWidth="288"
          Background="{DynamicResource Brush.Surface}"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image x:Name="TitleMarkIcon"
                           Width="32"
                           Height="32"
                           Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"/>
                    <TextBlock Text="SmoothMice"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="?"
                        Style="{StaticResource IconCircleButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Help_OnClick"
                        ToolTip="Help"/>
            </Grid>
            <TextBlock x:Name="VersionLabel"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.Muted}"
                       SnapsToDevicePixels="True"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Card}"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,8">
            <StackPanel>
                <CheckBox Content="Auto start on login"
                          IsChecked="{Binding AutoStartOnLogin, Mode=TwoWay}"
                          Checked="PersistCheck_OnChanged"
                          Unchecked="PersistCheck_OnChanged"/>
                <CheckBox Content="Dark mode"
                          Margin="0,4,0,0"
                          ToolTip="Use the dark application palette"
                          AutomationProperties.Name="Dark mode"
                          IsChecked="{Binding DarkMode, Mode=TwoWay}"/>
                <CheckBox Content="Do not activate in games"
                          Margin="0,4,0,0"
                          ToolTip="Lets the mouse wheel pass through natively in conservatively detected games"
                          AutomationProperties.Name="Do not activate in games"
                          IsChecked="{Binding DoNotActivateInGames, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Card}"
                CornerRadius="10"
                Padding="10,6"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProfileCombo"
                          Grid.Column="0"
                          Margin="0"
                          SelectionChanged="ProfileCombo_OnSelectionChanged"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="6,0,0,0">
                    <Button Content="+"
                            Width="32"
                            Height="28"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddProfileCommand}"
                            ToolTip="Add profile"/>
                    <Button Content="—"
                            Width="32"
                            Height="28"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RemoveProfileCommand}"
                            ToolTip="Remove profile"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Card}"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,8">
            <StackPanel>
                <CheckBox Content="Enabled"
                          IsChecked="{Binding ProfileEnabled, Mode=TwoWay}"
                          Checked="PersistCheck_OnChanged"
                          Unchecked="PersistCheck_OnChanged"/>
                <CheckBox Content="Animation easing"
                          IsChecked="{Binding AnimationEasing, Mode=TwoWay}"
                          Checked="PersistCheck_OnChanged"
                          Unchecked="PersistCheck_OnChanged"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource Brush.Card}"
                CornerRadius="12"
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.06"
                                  Color="{DynamicResource C.Shadow}"
                                  Direction="270"/>
            </Border.Effect>
            <Grid Margin="12,10"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="88"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="88"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Animation" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Step size (px)" Style="{StaticResource FieldLabel}"/>
                    <TextBox LostFocus="Numeric_OnLostFocus"
                             KeyDown="Numeric_OnKeyDown"
                             Text="{Binding StepSizePx, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            Converter={StaticResource DoubleStr}}"/>

                    <TextBlock Text="Animation time (ms)" Style="{StaticResource FieldLabel}"/>
                    <TextBox LostFocus="Numeric_OnLostFocus"
                             KeyDown="Numeric_OnKeyDown"
                             Text="{Binding AnimationTimeMs, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            Converter={StaticResource IntStr}}"/>

                    <TextBlock Text="Tail / head ratio"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="Used only when Animation easing is on and Start smoothing is 0 (auto)"/>
                    <TextBox LostFocus="Numeric_OnLostFocus"
                             KeyDown="Numeric_OnKeyDown"
                             IsEnabled="{Binding IsTailToHeadRatioEffective}"
                             Text="{Binding TailToHeadRatio, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            Converter={StaticResource DoubleStr}}"/>

                    <TextBlock Text="Start smoothing (ms, 0 = auto)"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="Ease-in time of each notch. Used only when Animation easing is on; capped at half the Animation time so every scroll still eases out"/>
                    <TextBox LostFocus="Numeric_OnLostFocus"
                             KeyDown="Numeric_OnKeyDown"
                             IsEnabled="{Binding AnimationEasing}"
                             Text="{Binding AttackTimeMs, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            Converter={StaticResource IntStr}}"/>
                </StackPanel>

                <Rectangle Grid.Column="1"
                             Fill="{DynamicResource Brush.Border}"
                             Width="1"
                             VerticalAlignment="Stretch"
                             Margin="0,4"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Acceleration" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Curve preset" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="AccelPresetCombo"
                              ItemsSource="{x:Static vm:MainViewModel.AccelPresetNames}"
                              SelectionChanged="AccelPreset_OnSelectionChanged"/>

                    <TextBlock Text="Exponent"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="0 = disabled · 1 = linear · 1.3 = smooth · 2 = exponential"/>
                    <TextBox LostFocus="Numeric_OnLostFocus"
                             KeyDown="Numeric_OnKeyDown"
                             Text="{Binding AccelerationExponent, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            Converter={StaticResource DoubleStr}}"/>

                    <TextBlock Text="Max multiplier" Style="{StaticResource FieldLabel}"/>
                    <TextBox LostFocus="Numeric_OnLostFocus"
                             KeyDown="Numeric_OnKeyDown"
                             Text="{Binding AccelerationMaxX, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            Converter={StaticResource DoubleStr}}"/>

                    <TextBlock Text="Reference interval (ms)"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="Scroll speed at this interval = 1× multiplier"/>
                    <TextBox LostFocus="Numeric_OnLostFocus"
                             KeyDown="Numeric_OnKeyDown"
                             Text="{Binding AccelerationDeltaMs, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            Converter={StaticResource IntStr}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Background="{DynamicResource Brush.Card}"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource SectionHeader}"/>
                <DockPanel LastChildFill="True">
                    <Button Content="Check for updates"
                            DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"
                            Command="{Binding CheckForUpdatesCommand}"/>
                    <ComboBox x:Name="UpdateFreqCombo"
                              Margin="0"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Frequency"
                              ItemsSource="{Binding UpdateFrequencyOptions}"
                              SelectedValue="{Binding UpdateCheckFrequency, Mode=TwoWay}"
                              SelectionChanged="UpdateFreqCombo_OnSelectionChanged"/>
                </DockPanel>
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UpdateBannerStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Muted}"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"/>
                    <ProgressBar Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding UpdateBannerProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding UpdateBannerIndeterminate}"
                               Foreground="{DynamicResource Brush.Accent}"
                               Background="{DynamicResource Brush.Border}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Margin="0,8,0,0">
            <Button Content="Free-Spin Inertia Suppression (beta)"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SecondaryButton}"
                    Click="FreeSpinInertiaSuppression_OnClick"
                    ToolTip="Opens the Free-Spin wheel-event preparation module"
                    AutomationProperties.Name="Free-Spin Inertia Suppression (beta)"/>
            <Button Content="Scroll logs"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SecondaryButton}"
                    Click="MonitorScroll_OnClick"
                    ToolTip="Opens a live monitor of physical wheel pulses"
                    AutomationProperties.Name="Scroll logs"/>
            <Button Content="Reset All"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ResetAllCommand}"/>
        </StackPanel>
    </Grid>
</Window>
