<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SmoothMice.App</RootNamespace>
    <!-- Publish artifact: SmoothMice-{Version}.exe; the Inno installer copies it as SmoothMice.exe -->
    <AssemblyName>SmoothMice-$(Version)</AssemblyName>
    <ApplicationIcon>SmoothMice.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="SmoothMice.ico" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmoothMice.Core\SmoothMice.Core.csproj" />
    <ProjectReference Include="..\SmoothMice.Infrastructure\SmoothMice.Infrastructure.csproj" />
  </ItemGroup>
</Project>
